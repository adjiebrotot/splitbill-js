{
  "name": "splitbill-js",
  "version": "0.1.0",
  "private": true,
  "description": "Split Bill: split bills among friends. Next.js + Postgres, serving a PWA, Telegram bot and JSON API.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
