# Split Bill: environment variables. Copy to .env.local (gitignored).

# Postgres. In prod point at the Neon *-pooler* host.
DATABASE_URL=postgresql://user:password@host-pooler:5432/dbname?sslmode=require
# "neon" (serverless WebSocket/HTTP, prod) or "pg" (TCP, local).
DB_DRIVER=neon

# Signs session cookies and guards POST /app/api/admin/migrate. Long random string.
SETUP_SECRET=replace-with-a-long-random-secret

# Password for the admin console at /admin. Long random string; unset = console off.
# Changing it signs every admin session out.
ADMIN_PASSWORD=replace-with-a-long-admin-password

# Default time zone for new users and groups (IANA).
USER_TIMEZONE=Asia/Jakarta

# OpenRouter key for chat and receipt-photo reading.
LLM_API_KEY=replace-with-openrouter-key
# Optional OpenRouter model overrides (defaults in src/services/llm_client.ts)
# LLM_TEXT_MODEL=openai/gpt-oss-20b
# LLM_IMAGE_MODEL=google/gemma-4-26b-a4b-it
# LLM_PROVIDER_SORT=latency   (throughput | price | off)
# Max AI reads per user per day.
AI_DAILY_LIMIT=50

# Telegram bot token from @BotFather, and the bot's username (no @).
TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
TELEGRAM_BOT_USERNAME=YourSplitBillBot

# Public base URL (Google OAuth redirect, Telegram links, report footer).
PUBLIC_BASE_URL=https://your-app.vercel.app

# Google sign-in (optional). Redirect URI: ${PUBLIC_BASE_URL}/app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email verification codes via Resend. Unset = codes are logged to the console.
RESEND_API_KEY=
EMAIL_FROM=Split Bill <no-reply@your-domain.com>

# Vercel Blob read-write token: stores user photos (avatars). Unset = no photo
# upload; everyone keeps the initials avatar.
BLOB_READ_WRITE_TOKEN=

# Vercel Cron shared secret (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=replace-with-cron-secret
